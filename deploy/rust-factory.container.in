# Podman Quadlet unit for one host, generated by scripts/deploy.sh. Do not edit on the host.
# @NAME@, @ENV@, @IMAGE@ and @PORT@ are filled in per host.
[Unit]
Description=rust-factory service (@ENV@ / @NAME@)
After=network-online.target

[Container]
Image=@IMAGE@
ContainerName=rust-factory-@NAME@
Network=host
Environment=PORT=@PORT@
Label=app=rust-factory
Label=environment=@ENV@
# Health check: the image's own HEALTHCHECK (["/app", "healthcheck"], exec form). Do NOT set
# HealthCmd= here: Quadlet passes a plain string to podman as a *shell* command, and the
# distroless image has no shell, so the check would always fail (found in the first pilot deploy).
# systemd treats the service as started only once it is healthy (Notify=healthy), and kills it
# (then restarts it) if it becomes unhealthy later.
HealthInterval=10s
HealthStartPeriod=5s
HealthRetries=3
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=60

[Install]
WantedBy=default.target
